{
    "$schema": "https://getcomposer.org/schema.json",
    "description": "Reference only. Local path repository settings live in composer.json.",
    "require": {
        "bladewindui/ui": "dev-development"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "bladewindui/ui": {
            "type": "path",
            "url": "../bladewindui",
            "options": {
                "symlink": true,
                "versions": {
                    "bladewindui/ui": "dev-development"
                }
            }
        }
    }
}
